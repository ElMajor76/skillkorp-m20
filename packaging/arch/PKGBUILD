# Maintainer: nplacide <nplacide95@gmail.com>
pkgname=skillkorp-m20
pkgver=1.1.0
pkgrel=1
pkgdesc="Pilote Linux, utilitaire CLI et GUI pour souris gaming SkillKorp M20 Ultimate"
arch=('any')
url="https://github.com/ElMajor76/skillkorp-m20"
license=('MIT')
depends=('python' 'python-gobject' 'libadwaita' 'systemd')
optdepends=('libayatana-appindicator: support de l\'indicateur dans la barre des tâches'
            'libnotify: notifications de bureau pour la batterie et le DPI')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ElMajor76/$pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver" 2>/dev/null || cd "$srcdir/$pkgname" 2>/dev/null || cd "$startdir/../.."

    install -dm755 "$pkgdir/usr/share/$pkgname"
    install -Dm755 m20_driver.py "$pkgdir/usr/share/$pkgname/m20_driver.py"
    install -Dm755 profile_manager.py "$pkgdir/usr/share/$pkgname/profile_manager.py"
    install -Dm755 m20_gui.py "$pkgdir/usr/share/$pkgname/m20_gui.py"
    install -Dm755 m20_tray.py "$pkgdir/usr/share/$pkgname/m20_tray.py"
    install -Dm755 m20ctl "$pkgdir/usr/share/$pkgname/m20ctl"
    cp -r assets "$pkgdir/usr/share/$pkgname/"

    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/share/$pkgname/m20ctl" "$pkgdir/usr/bin/m20ctl"
    ln -s "/usr/share/$pkgname/m20_gui.py" "$pkgdir/usr/bin/m20-gui"
    ln -s "/usr/share/$pkgname/m20_tray.py" "$pkgdir/usr/bin/m20-tray"

    install -Dm644 udev/99-skillkorp-m20.rules "$pkgdir/usr/lib/udev/rules.d/99-skillkorp-m20.rules"
    install -Dm644 io.github.skillkorp.m20.desktop "$pkgdir/usr/share/applications/io.github.skillkorp.m20.desktop"
    install -Dm644 assets/skillkorp-m20.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/skillkorp-m20.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
